# Auth Bot environment variables — example file
# The bot loads `.env.<NODE_ENV>` from the repo root (see src/config/index.ts):
#   NODE_ENV=development -> .env.development 
#   NODE_ENV=production  -> .env.production

# --- Runtime mode ---
NODE_ENV=development

# --- Backend service ---
BACKEND_BASE_URL=http://127.0.0.1:8001
BACKEND_SERVICE_TOKEN=replace-me
REQUEST_TIMEOUT_MS=10000

# --- Discord application ---
BOT_TOKEN=replace-me
BOT_CLIENT_ID=000000000000000000
DISCORD_GUILD_ID=000000000000000000

# --- Channels
CHANNEL_WELCOME_ID=000000000000000000
CHANNEL_COMMANDS_CIV6_ID=000000000000000000
CHANNEL_COMMANDS_CIV7_ID=000000000000000000
CHANNEL_BOT_COMMANDS_ID=000000000000000000
CHANNEL_AUTHBOT_LOG_ID=000000000000000000
CHANNEL_AUTHBOT_REG_ID=000000000000000000

# --- Roles 
ROLE_MODERATOR=000000000000000000
ROLE_CIV6=000000000000000000
ROLE_CIV7=000000000000000000
ROLE_NOVICE=000000000000000000
ROLE_NON_VERIFIED=000000000000000000
# News/platform roles granted on registration 
ROLE_SERVER_NEWS=000000000000000000
ROLE_CIV6_NEWS=000000000000000000
ROLE_CIV7_NEWS=000000000000000000
ROLE_PC_STEAM=000000000000000000
# Optional for non-steam registrations.
ROLE_2K_CROSSPLATFORM=
# Optional: Epic role 
ROLE_EPIC=
# Optional. Developer override role for staff commands.
ROLE_DEVELOPER=000000000000000000