{
  "name": "auth-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Discord auth bot for CivCPL, backed by the core API.",
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "clean": "node --input-type=commonjs -e \"const fs=require('node:fs'); const path=require('node:path'); for (const p of ['dist','tsconfig.tsbuildinfo']) fs.rmSync(path.resolve(p), { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "npm run typecheck && npm run build && npm run lint",
    "dev": "tsx watch src/index.ts",
    "dev:deploy": "tsx src/deploy.ts",
    "start": "node --enable-source-maps dist/index.js",
    "deploy": "node --enable-source-maps dist/deploy.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  }
}
